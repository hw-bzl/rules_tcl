load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":tcl.bzl", "tcl_library")

exports_files([
    "binary_wrapper.bat.tpl",
    "binary_wrapper.sh.tpl",
    "BUILD.tcllib.bazel",
    "entrypoint.tcl",
])

filegroup(
    name = "binary_wrapper.sh.bundle",
    srcs = ["binary_wrapper.sh.tpl"],
    data = ["@rules_shell//shell/runfiles"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "binary_wrapper.bat.bundle",
    srcs = ["binary_wrapper.bat.tpl"],
    data = ["@rules_batch//batch/runfiles"],
    visibility = ["//visibility:public"],
)

alias(
    name = "binary_wrapper.tpl",
    actual = select({
        "@platforms//os:windows": ":binary_wrapper.bat.bundle",
        "//conditions:default": ":binary_wrapper.sh.bundle",
    }),
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "bzl_lib",
    srcs = glob(["*.bzl"]),
    visibility = [
        "//tcl:__pkg__",
        "//tcl/nagelfar:__pkg__",
        "//tcl/private:__subpackages__",
        "//tcl/tclint:__pkg__",
    ],
)

tcl_library(
    name = "entrypoint",
    srcs = [
        "entrypoint.tcl",
        "pkgIndex.tcl",
    ],
)
