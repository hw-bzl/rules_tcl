"""examples"""

module(
    name = "rules_tcl_examples",
    version = "0.0.0",
)

bazel_dep(name = "rules_tcl", version = "0.0.0")
local_path_override(
    module_name = "rules_tcl",
    path = "../",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "tcl_lang", version = "9.0.2.bcr.1")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "tcllib",
    build_file = "@rules_tcl//tcl/private:BUILD.tcllib.bazel",
    integrity = "sha256-ZCwsZ5yQF6tv3tAzJOTOm19Ckkc7YlIOgqrOu2PAziA=",
    strip_prefix = "tcllib-2.0",
    urls = ["https://core.tcl-lang.org/tcllib/uv/tcllib-2.0.tar.xz"],
)

register_toolchains(
    "//toolchain",
)
